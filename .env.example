# Supabase (optional for local/demo use — the app runs fully without these,
# using localStorage-backed auth + data and seeded demo content instead).
# Set both to enable real accounts, Postgres persistence and Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider (optional). The app ships a deterministic meal-planning and
# natural-language-command engine that works with no key at all. Setting
# this to "true" only flips a UI flag (isAIConfigured) — wiring an actual
# provider call requires a secure backend/edge function; see the comment at
# the top of src/services/aiService.ts.
VITE_AI_ENABLED=false
